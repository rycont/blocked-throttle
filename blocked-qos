#!/usr/bin/env bash
# Zen flatpak scope에서 나가는 패킷에만 지연/지터/손실을 넣는다. cgroup 매칭이라 도메인/SNI/DNS 무관.
set -eu
MARK=0x2e
TABLE=blockedqos

# 세기 조절: sudo -e /usr/local/sbin/blocked-qos
DELAY=2000ms JITTER=800ms LOSS=2%
iface() { ip -o route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="dev") print $(i+1)}' | head -1; }

case "${1:-}" in
on)
  scope=$(ls -d /sys/fs/cgroup/user.slice/user-*.slice/user@*.service/app.slice/app-flatpak-app.zen_browser.zen-*.scope 2>/dev/null | head -1) || exit 0
  [[ -z ${scope:-} ]] && { echo "zen scope 없음"; exit 0; }
  path=${scope#/sys/fs/cgroup/}
  level=$(awk -F/ '{print NF}' <<<"$path")
  dev=$(iface); [[ -z $dev ]] && { echo "기본 경로 인터페이스 없음"; exit 1; }

  nft delete table inet $TABLE 2>/dev/null || true
  nft -f - <<EOF
table inet $TABLE {
  chain out {
    type filter hook output priority mangle; policy accept;
    socket cgroupv2 level $level "$path" meta mark set $MARK
  }
}
EOF
  tc qdisc replace dev "$dev" root handle 1: prio bands 3
  tc qdisc replace dev "$dev" parent 1:3 handle 30: netem \
     delay "$DELAY" "$JITTER" distribution normal loss "$LOSS"
  tc filter replace dev "$dev" parent 1: protocol all prio 1 handle $MARK fw flowid 1:3
  echo "on: $dev, delay $DELAY ±$JITTER, loss $LOSS"
  ;;
off)
  nft delete table inet $TABLE 2>/dev/null || true
  dev=$(iface); [[ -n ${dev:-} ]] && tc qdisc del dev "$dev" root 2>/dev/null || true
  echo off
  ;;
*) echo "usage: blocked-qos on|off" >&2; exit 2 ;;
esac
